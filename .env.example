# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/bridgeb?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=bridgeb

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server Port
PORT=3001

# Client API URL
VITE_API_BASE_URL=http://localhost:3001/api

# Node Environment
NODE_ENV=development
